{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/pri8771/iOS_app_factory_rules/main/schemas/standard-lock.schema.json",
  "title": "App Factory Standard Lock",
  "type": "object",
  "required": [
    "standardRepository",
    "standardRepositoryUrl",
    "standardVersion",
    "standardRef",
    "profiles",
    "repositoryMapVersion",
    "repositoryMapPath",
    "libraryCatalogVersion",
    "libraryCatalogPath",
    "installedAt"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "standardRepository": {"type": "string", "minLength": 1},
    "standardRepositoryUrl": {"type": "string", "minLength": 1},
    "standardVersion": {"type": "string", "minLength": 1},
    "standardRef": {"type": "string", "minLength": 1},
    "profiles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "repositoryMapVersion": {"type": "string", "minLength": 1},
    "repositoryMapPath": {"type": "string", "minLength": 1},
    "libraryCatalogVersion": {"type": "string", "minLength": 1},
    "libraryCatalogPath": {"type": "string", "minLength": 1},
    "installedAt": {"type": "string", "format": "date"},
    "upgradedAt": {"type": "string", "format": "date"},
    "previousStandardVersion": {"type": "string"}
  },
  "additionalProperties": true
}
